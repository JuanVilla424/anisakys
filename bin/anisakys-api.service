[Unit]
Description=Anisakys - REST API Server
After=network.target

[Service]
Type=simple
User=anisakys
Group=anisakys
WorkingDirectory=/opt/anisakys
EnvironmentFile=/opt/anisakys/.env
ExecStart=/opt/anisakys/venv/bin/python anisakys.py --start-api
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
