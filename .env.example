TIMEOUT=50
SCAN_INTERVAL=20400
KEYWORDS=fb,facebook,face,book
ALLOWED_SITES=www.fb.com,www.facebook.com
SMTP_HOST=localhost
SMTP_PORT=1125
ABUSE_EMAIL_SENDER=email@dominio.com
ABUSE_EMAIL_SUBJECT="Abuse Report for Phishing Site"
DEFAULT_CC_EMAILS=primary@example.com
DEFAULT_CC_EMAILS_ESCALATION_LEVEL2=esc2@example.com
DEFAULT_CC_EMAILS_ESCALATION_LEVEL3=esc3@example.com
DEFAULT_ATTACHMENT=attachments/file.pdf
ATTACHMENTS_FOLDER=attachments/
POSTGRES_DB=anisakys_db
# Never commit real credentials: generate a strong password per deployment.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/anisakys_db
# Connection pooling: 0 = none (default). Set e.g. 5 for the API under gunicorn.
#DB_POOL_SIZE=0
#DB_MAX_OVERFLOW=5
QUERIES_FILE=queries.txt
OFFSET_FILE=offset.txt

# ICANN Compliance Features
SCREENSHOTS_DIR=screenshots/
# SMTP_USER=your_smtp_user  # Optional - only if SMTP server requires authentication
# SMTP_PASS=your_smtp_password  # Optional - only if SMTP server requires authentication
SMTP_RATE_LIMIT_PER_HOUR=100  # Max outbound abuse report emails per hour, shared by all processes
# TLS policy for the relay: auto (STARTTLS when offered, SSL on 465), starttls, ssl, none.
# Credentials are never sent over an unencrypted connection.
# SMTP_SECURITY=auto
# SMTP_TIMEOUT_SECONDS=30
MAX_ATTACHMENT_SIZE_MB=25
MAX_EMAIL_SIZE_MB=25

# Multi-API Analysis Configuration
VIRUSTOTAL_API_KEY=your_virustotal_api_key
URLVOID_API_KEY=your_urlvoid_api_key
PHISHTANK_API_KEY=your_phishtank_api_key
AUTO_MULTI_API_SCAN=true
AUTO_REPORT_THRESHOLD_CONFIDENCE=85
MANUAL_REVIEW_THRESHOLD_CONFIDENCE=70
AUTO_ANALYSIS_DELAY_SECONDS=30
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key

# URLVoid's API client is unverified against the vendor's current API: keep it off
# until it is validated with a real key.
# URLVOID_ENABLED=false
# VirusTotal public API allows 4 requests/minute (non-commercial use only).
# VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# Google Web Risk submissions (commercial-use alternative to Safe Browsing reports):
# requires an allow-listed Google Cloud project and a service account (OAuth).
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# The legacy crx-report endpoint is undocumented; results are reported as unverified.
# GSB_CRX_REPORT_ENABLED=true

# Takedown verification: a site is "down" only after N consecutive failing
# checks from every probe profile; challenges/parking never count as down.
# TAKEDOWN_CONSECUTIVE_FAILURES=3
# TAKEDOWN_PROBE_WORKERS=4

# Optional Grinder Integration
GRINDER0X_API_URL=https://your-grinder-instance.com:8080
GRINDER0X_API_KEY=your_grinder_api_key

# Anisakys API Server
# ANISAKYS_API_KEY is the master key (every scope). Per-client keys are created
# with `python -m src.cli.api_keys create --name NAME --scopes SCOPES`; scopes:
#   read, scan, write, metrics, admin (wildcard)
#   report       POST /api/v1/report records the URL for analyst approval only
#   report_send  submitted URLs are reported to abuse contacts without approval,
#                and /api/v1/gsb/report is allowed (implies report). Approve a
#                pending submission by re-submitting it with such a key.
#   email_admin  create/update e-mail monitor threads, read per-mailbox results
# Existing keys keep their scopes: grant report_send/email_admin explicitly.
ANISAKYS_API_KEY=your_secure_api_key_here
ANISAKYS_API_PORT=8080
# Production: serve with gunicorn ('src.api.wsgi:create_app()', see entrypoint-backend.sh).
# Interface of the development server started by --start-api (never exposed by default).
# API_BIND_HOST=127.0.0.1
# Reverse proxies in front of the API whose X-Forwarded-For/-Proto are trusted
# (e.g. 1 behind a single nginx). 0 = ignore forwarded headers.
# TRUSTED_PROXY_HOPS=0
# Rate-limit counters. Unset = in-memory, enforced per process (each gunicorn
# worker counts separately). Use Redis in production so limits are shared.
# RATELIMIT_STORAGE_URL=redis://redis:6379/0
# Bearer token Prometheus uses to scrape /metrics (API keys with the "metrics"
# or "read" scope are accepted too). Unset = only API keys can scrape.
# METRICS_TOKEN=generate_a_long_random_token

# Process roles: exactly one process must run the background jobs (reporting,
# outbox delivery, follow-ups, takedown monitor, GSB rescan, schedulers).
#   all        development: API/scanner plus every job in one process
#   api        HTTP only (gunicorn uses this implicitly)
#   scanner    domain scanning only
#   scheduler  background jobs only (one active leader, others stand by)
# PROCESS_ROLE=all
# SCHEDULER_LEADER_LOCK=true

# Abuse reporting pipeline (transactional outbox)
# REPORT_BRAND_NAME=Your Brand
# REPORT_ORGANIZATION=Your SOC
# REPORT_REPRODUCTION_NOTE=Visible from Colombian residential IPs with a mobile user agent.
# REPORT_RESEND_COOLDOWN_HOURS=48
# REPORT_MAX_PRIMARY_RECIPIENTS=5
# OUTBOX_MAX_ATTEMPTS=3
# OUTBOX_RETRY_BACKOFF_SECONDS=900
# FOLLOWUP_INTERVAL_HOURS=48
# FOLLOWUP_MAX_COUNT=3
# GSB_SCREENSHOT_MAX_BYTES=4000000

# Image Tracking & Google Ads Search (optional — requires SerpApi account)
# SERPAPI_KEY=your_serpapi_key
# S3_DATA_BUCKET=your-s3-bucket-name
# AWS_REGION=us-east-1

# Email Threat Monitoring (optional — requires Google Workspace service account)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_WORKSPACE_DOMAIN=yourdomain.com
# EMAIL_ABUSE_MAILBOX=abuse@yourdomain.com
# EMAIL_MONITORED_MAILBOXES=user1@yourdomain.com,user2@yourdomain.com
# Mailboxes the API may create e-mail monitor threads for (requires an API key
# with the "email_admin" scope). Comma-separated; "@yourdomain.com" allows every
# mailbox of the domain and domain-wide monitoring. EMAIL_ABUSE_MAILBOX and
# EMAIL_MONITORED_MAILBOXES are always allowed. Unset = nothing else allowed.
# EMAIL_MONITOR_ALLOWED_MAILBOXES=soc@yourdomain.com
# Workspace customer for the blocked-senders policy ("my_customer" = your own).
# GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
# EMAIL_BLOCK_THRESHOLD=5
# EMAIL_POLL_INTERVAL_MINUTES=15

# Logging Configuration
LOG_LEVEL=INFO
# One JSON log file per process: <LOG_DIR>/anisakys-<role>-<pid>.log (empty LOG_DIR = console only)
#LOG_DIR=logs
#LOG_PROCESS_NAME=
#LOG_MAX_BYTES=20971520
#LOG_BACKUP_COUNT=5
# Console output: text or json
#LOG_CONSOLE_FORMAT=text

# Test mode: all abuse report emails are redirected to this address only
# TEST_EMAIL=your_test_email@example.com
