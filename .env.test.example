# Test configuration. Copy to .env.test (git-ignored) before running pytest:
#   cp .env.test.example .env.test
# Requires a PostgreSQL 16 server; the test database is created on first run.
KEYWORDS=paypal,bank
DOMAINS=com,net
SMTP_HOST=127.0.0.1
# Port 2 is intentionally unreachable: tests must never send real e-mail.
SMTP_PORT=2
ABUSE_EMAIL_SENDER=sender@example.invalid
ABUSE_EMAIL_SUBJECT=Test Abuse Report
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/anisakys_test
QUERIES_FILE=queries_test.txt
OFFSET_FILE=offset_test.txt
SCREENSHOTS_DIR=./.test-screenshots
TIMEOUT=5
LOG_LEVEL=INFO
