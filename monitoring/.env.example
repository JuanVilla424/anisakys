# Monitoring stack configuration
# Copy to .env and set real values

# Grafana admin password (required)
GRAFANA_ADMIN_PASSWORD=change_me_before_deploy

# Prometheus authenticates to the backend's /metrics with a bearer token read
# from monitoring/secrets/metrics_token (one line, no newline needed). Use the
# backend's METRICS_TOKEN value, or an API key created with --scopes metrics.
